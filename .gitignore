# ---- 环境变量 / 密钥（只保留示例文件） ----
.env
.env.*
!.env.example
**/.env
**/.env.*
!**/.env.example

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
venv/
coverage.xml
htmlcov/

# ---- 数据库与上传材料（含真实数据，不入库） ----
*.db
*.sqlite3
backend/uploads/
backend/*_uploads/
backend/private/
uploads/

# ---- 前端依赖与构建产物 ----
node_modules/
frontend/node_modules/
frontend/dist/
dist/
*.local

# ---- 编辑器与系统文件 ----
.idea/
.vscode/
*.iml
.DS_Store
Thumbs.db
desktop.ini

# ---- 日志与临时文件 ----
*.log
npm-debug.log*
tmp/
temp/
*.corrupt
*.bak
*.orig
*.zip
